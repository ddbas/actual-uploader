{
  "name": "account-crawler",
  "version": "1.0.0",
  "description": "",
  "type": "module",
  "scripts": {
    "format": "turbo run //#format:biome //#format:prettier",
    "format:biome": "biome check --write --no-errors-on-unmatched --files-ignore-unknown=true .",
    "format:prettier": "prettier --write \"**/*.md\"",
    "dev": "turbo run dev",
    "build": "turbo run build",
    "test": "turbo run test",
    "check-types": "turbo run check-types"
  },
  "devDependencies": {
    "@biomejs/biome": "2.5.7",
    "prettier": "3.9.6",
    "turbo": "^2.11.9",
    "typescript": "^7.0.2"
  },
  "devEngines": {
    "packageManager": {
      "name": "pnpm",
      "version": "^11.20.0",
      "onFail": "download"
    }
  }
}
