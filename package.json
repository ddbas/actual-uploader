{
  "name": "account-crawler",
  "version": "1.0.0",
  "description": "",
  "type": "module",
  "scripts": {
    "format": "turbo run //#format:biome",
    "format:biome": "biome check --write --no-errors-on-unmatched --files-ignore-unknown=true .",
    "dev": "turbo run dev",
    "build": "turbo run build",
    "test": "turbo run test",
    "check-types": "turbo run check-types"
  },
  "devDependencies": {
    "@biomejs/biome": "2.6.3",
    "turbo": "^2.11.9",
    "typescript": "^7.0.2"
  },
  "devEngines": {
    "packageManager": {
      "name": "pnpm",
      "version": "^11.20.0",
      "onFail": "download"
    }
  }
}
