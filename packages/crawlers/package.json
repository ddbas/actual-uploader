{
  "name": "crawlers",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "default": "./dist/index.js"
    }
  },
  "scripts": {
    "build": "tsup && tsc -p tsconfig.build.json --outDir dist",
    "check-types": "tsc --noEmit -p tsconfig.json",
    "test": "vitest run",
    "test:smoke": "tsx scripts/smoke-mock.ts",
    "dev": "tsup --watch"
  },
  "dependencies": {
    "crawler-core": "workspace:*",
    "playwright": "^1.62.1"
  },
  "devDependencies": {
    "@types/node": "^26.2.0",
    "tsup": "^8.5.1",
    "tsx": "^4.23.11",
    "typescript": "^7.0.2",
    "vitest": "^4.1.10"
  }
}
