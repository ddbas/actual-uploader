{
  "name": "statement-core",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "default": "./dist/index.js"
    },
    "./testing": {
      "types": "./dist/pdf/fixture.d.ts",
      "default": "./dist/testing.js"
    }
  },
  "scripts": {
    "build": "tsc --noEmit -p tsconfig.json && tsup && tsc -p tsconfig.build.json --outDir dist",
    "test": "vitest run",
    "dev": "tsup --watch"
  },
  "devDependencies": {
    "tsup": "^8.5.1",
    "typescript": "^7.0.2",
    "vitest": "^4.1.12"
  }
}
