{
  "name": "statement-pdf",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "default": "./dist/index.js"
    },
    "./testing": {
      "types": "./dist/testing.d.ts",
      "default": "./dist/testing.js"
    }
  },
  "scripts": {
    "build": "tsup && tsc -p tsconfig.build.json --outDir dist",
    "check-types": "tsc --noEmit -p tsconfig.json",
    "test": "vitest run",
    "dev": "tsup --watch"
  },
  "dependencies": {
    "pdfjs-dist": "^5.7.284",
    "statement-core": "workspace:*"
  },
  "devDependencies": {
    "@types/node": "^26.2.0",
    "tsup": "^8.5.1",
    "typescript": "^7.0.2",
    "vitest": "^4.1.12"
  }
}
