{
  "$schema": "https://turborepo.dev/schema.json",
  "tasks": {
    "build": {
      "dependsOn": ["^build"],
      "outputs": ["dist/**"]
    },
    "test": {
      "outputs": ["coverage/**"],
      "dependsOn": ["^build"]
    },
    "//#format:biome": {
      "inputs": [
        "**/*.{js,ts,cjs,mjs,d.cts,d.mts,jsx,tsx,json,jsonc,css,md}",
        "biome.json"
      ]
    },
    "dev": {
      "passThroughEnv": [
        "ACTUAL_SERVER_URL",
        "ACTUAL_SERVER_PASSWORD",
        "ACTUAL_SYNC_ID",
        "ACTUAL_ENCRYPTION_PASSWORD",
        "DATA_DIR",
        "HOST",
        "PORT"
      ],
      "persistent": true,
      "cache": false
    }
  }
}
