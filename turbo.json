{
  "$schema": "https://turborepo.dev/schema.json",
  "tasks": {
    "build": {
      "dependsOn": ["^build"],
      "outputs": ["dist/**"]
    },
    "check-types": {
      "dependsOn": ["^check-types"]
    },
    "test": {
      "outputs": ["coverage/**"],
      "dependsOn": ["^build"]
    },
    "//#format:biome": {
      "inputs": [
        "**/*.{js,ts,cjs,mjs,d.cts,d.mts,jsx,tsx,json,jsonc,css}",
        "biome.json"
      ]
    },
    "//#format:prettier": {
      "inputs": ["**/*.md", ".prettierrc.json", ".prettierignore"]
    },
    "dev": {
      "persistent": true,
      "cache": false
    }
  }
}
